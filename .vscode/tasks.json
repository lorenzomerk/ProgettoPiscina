{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compila Gestione Piscina",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "$sources = Get-ChildItem -Recurse -Filter *.java -Path src/main/java,src/test/java; javac -encoding UTF-8 -cp 'lib/*' -d bin $sources.FullName"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$javac",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
